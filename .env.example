# ============================================================
#  JARVIS configuration  -  copy this file to ".env" and fill in
# ============================================================

# Which brain to use:
#   "claude_code" - Claude via the `claude` CLI, using your Claude Max/Pro
#                   SUBSCRIPTION (no API fees). Best quality + free if you
#                   already pay for Claude. Requires Claude Code installed
#                   and logged in (see SETUP.md).
#   "anthropic"   - Claude via a paid ANTHROPIC_API_KEY (per-token billing).
#   "ollama"      - a free local model on your own machine.
JARVIS_BACKEND=claude_code

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
JARVIS_MODEL=claude-opus-4-8

# --- Ollama (free local LLM) ---
# Install from https://ollama.com then run:  ollama pull llama3.1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Voice ---
JARVIS_VOICE=true          # set false to disable text-to-speech replies

# --- Telegram (optional, talk to JARVIS from your phone) ---
# Create a bot with @BotFather to get the token.
TELEGRAM_BOT_TOKEN=
# Your own Telegram numeric user id (so only you can command JARVIS).
TELEGRAM_ALLOWED_USER_ID=

# --- Safety ---
# When true, JARVIS asks before running shell commands or deleting files.
JARVIS_CONFIRM_DANGEROUS=true

# --- Job applications ---
# Your profile (contact info, experience, canned answers). See profile.example.json.
JARVIS_PROFILE_PATH=
# Dedicated Chrome profile JARVIS drives, so you stay logged in to job sites.
JARVIS_CHROME_DIR=
